{
  "name": "whatsapp-ts-bot",
  "version": "1.0",
  "main": "dist/chatbot.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/chatbot.js",
    "dev": "npx ts-node src/chatbot.ts",
    "pack": "pkg . --targets node18-win-x64 --output package/SensacaoBot.exe"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "fs": "^0.0.1-security",
    "moment-timezone": "^0.6.0",
    "puppeteer": "^24.15.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "latest"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "bin": "dist/chatbot.js",
  "pkg": {
    "scripts": "dist/**/*.js",
    "pkg": {
      "scripts": "dist/**/*.js",
      "assets": ["dist/chromium"]
    }
  }
}
